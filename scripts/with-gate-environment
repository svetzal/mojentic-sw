#!/bin/sh
# Keep foreground gates consistent in isolated worktrees.
set -eu

# Global manifest/module caches can be read-only inside the Foundry sandbox.
# Resolve this path from the repository, even when invoked with a relative path.
gate_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export XDG_CACHE_HOME="$gate_root/.build/audit-cache"
mkdir -p "$XDG_CACHE_HOME"

# Both mandatory test modes verify the exact executable contract sources first.
if [ "${1-}" = swift ] && [ "${2-}" = test ]; then
    "$gate_root/scripts/check-deterministic-tests"
    "$gate_root/scripts/verify-contract-manifests"
fi

# Preserve signals and the command's exit status; do not leave a wrapper process.
exec "$@"
