#!/bin/sh
# Reject infrastructure/timing operations in repository test and verifier paths.
#
# This textual guard complements the call-path review in docs/DETERMINISTIC-TESTS.md.
# It is deliberately not a proof that an arbitrary new gateway is safely stubbed.
# It needs only POSIX sh, grep -E, sed, sort, tr and find, so it runs in the
# Linux CI containers, which have no python3.
set -eu
LC_ALL=C
export LC_ALL

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"

# Extended regular expressions, one per category. (^|[^[:alnum:]_]) is a
# portable leading word boundary. Escaped dots and parentheses, and the
# bracketed letters, keep this file from matching its own pattern text.
category_pattern() {
    case $1 in
        1) printf '%s\n' '(Task|Thread)\.sleep[[:space:]]*\(|(^|[^[:alnum:]_])(time\.sleep|usleep|nanosleep)[[:space:]]*\(' ;;
        2) printf '%s\n' '(^|[^[:alnum:]_])(socket|listen|accept|bind)[[:space:]]*\(|http\.server|ThreadingHTTP[S]erver' ;;
        3) printf '%s\n' '(^|[^[:alnum:]_])(curl|wget)[[:space:]]+https?://|(^|[^[:alnum:]_])Process[[:space:]]*\(|subprocess\.' ;;
        4) printf '%s\n' '(^|[^[:alnum:]_])Date\(\)|system[U]ptime|duration\(to:|ContinuousClock\.now\.advanced' ;;
    esac
}

category_name() {
    case $1 in
        1) printf '%s\n' 'real sleep' ;;
        2) printf '%s\n' 'socket/server' ;;
        3) printf '%s\n' 'external command' ;;
        4) printf '%s\n' 'wall-clock measurement' ;;
    esac
}

# The detector: print "line:text" for each standard-input line that matches
# category $1, except comment lines (first non-blank characters // or #).
detect() {
    grep -nE -- "$(category_pattern "$1")" | grep -vE '^[0-9]+:[[:space:]]*(//|#)' || true
}

# These inert strings exercise the same detector as the repository scan.
# Split literals keep the guard from mistaking its samples for operations.
samples=0
expect_rejected() {
    category=$1
    shift
    for operation in "$@"; do
        samples=$((samples + 1))
        if [ -z "$(printf '%s\n' "$operation" | detect "$category")" ]; then
            printf 'Guard failed to reject %s sample\n' "$(category_name "$category")" >&2
            exit 1
        fi
    done
}
expect_rejected 1 'Task.''sleep(1)' 'Thread.''sleep(1)' 'time.''sleep(1)' \
    'us''leep(1)' 'nano''sleep(1)'
expect_rejected 2 'sock''et()' 'lis''ten()' 'acc''ept()' 'bi''nd()' \
    'http.''server' 'ThreadingHTTP''Server'
expect_rejected 3 'cu''rl https://example.invalid' 'wg''et https://example.invalid' \
    'Pro''cess()' 'sub''process.run([])'
expect_rejected 4 'Da''te()' 'system''Uptime' 'duration''(to: next)' \
    'ContinuousClock.''now.advanced'
printf 'Rejected %s inert prohibited-operation samples\n' "$samples"

# Sort by path components, as the earlier implementation did: "/" sorts
# before every other byte.
sorted_paths() {
    tr / '\001' | sort | tr '\001' /
}

paths=$(
    find Tests -name '*.swift' -type f | sorted_paths
    for path in scripts/* scripts/.*; do
        if [ -f "$path" ]; then printf '%s\n' "$path"; fi
    done | sorted_paths
)

newline='
'
failures=''
inspected=0
while IFS= read -r path; do
    if [ -z "$path" ]; then continue; fi
    inspected=$((inspected + 1))
    hits=$(
        for category in 1 2 3 4; do
            detect "$category" <"$path" | sed "s/:/:$category:/"
        done | sort -t: -k1,1n -k2,2n | sed \
            -e 's/^\([0-9]*:[0-9]:\)[[:space:]]*/\1/' \
            -e 's/[[:space:]]*$//' \
            -e "s|^\\([0-9]*\\):1:|\\1: $(category_name 1): |" \
            -e "s|^\\([0-9]*\\):2:|\\1: $(category_name 2): |" \
            -e "s|^\\([0-9]*\\):3:|\\1: $(category_name 3): |" \
            -e "s|^\\([0-9]*\\):4:|\\1: $(category_name 4): |"
    )
    if [ -n "$hits" ]; then
        while IFS= read -r hit; do
            failures="$failures$path:$hit$newline"
        done <<EOF
$hits
EOF
    fi
done <<EOF
$paths
EOF

if [ -n "$failures" ]; then
    printf '%s' "$failures" >&2
    exit 1
fi
printf 'Inspected %s test/support/verifier paths: no prohibited operations\n' "$inspected"
