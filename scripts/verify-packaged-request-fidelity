#!/usr/bin/env python3
"""Verify a detached SwiftPM source archive through a fresh public-API consumer."""
import hashlib
import http.server
import json
import pathlib
import subprocess
import tarfile
import tempfile
import threading

root = pathlib.Path(__file__).resolve().parent.parent
contract_path = root / "Tests/MojenticTests/Fixtures/Contracts/request_fidelity_v1.json"
contract = json.loads(contract_path.read_text())
verified = []
rows = [("openai", row, row["explicit"]) for row in contract["cases"]]
rows += [("anthropic", row, explicit) for row in contract["anthropic_cases"]
         for explicit in [False, True]]
print(contract["version"], contract["revision"], hashlib.sha256(contract_path.read_bytes()).hexdigest(), flush=True)
subprocess.run(["sha256sum", "--check", str(contract_path.with_name("request_fidelity_v1.manifest.sha256"))],
               check=True, cwd=root)
subprocess.run(["git", "rev-parse", "HEAD"], check=True, cwd=root)


class Provider(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        provider, row, explicit = rows[len(verified)]
        case_id = row["id"] + (("/explicit" if explicit else "/default") if provider == "anthropic" else "")
        assert body["model"] == row["model"], (case_id, body)
        if provider == "openai":
            expected = row["expected"]
            assert self.headers["Authorization"] == "Bearer contract-secret"
        else:
            limit = row["explicit_max_tokens"] if explicit else row["max_tokens"]
            expected = {"max_tokens": limit}
            if explicit:
                expected["temperature"] = 0
            if row["thinking"]:
                expected["thinking"] = {"type": "enabled", "budget_tokens": max(1024, limit // 4)}
            assert self.headers["x-api-key"] == "contract-secret"
        for key in ["temperature", "max_tokens", "max_completion_tokens", "top_p", "reasoning_effort", "thinking"]:
            assert (key in body) == (key in expected), (case_id, key, body)
            assert body.get(key) == expected.get(key), (case_id, key, body)
        assert "num_ctx" not in body and "num_predict" not in body
        verified.append(case_id)
        print("PASS provider " + case_id, flush=True)
        payload = contract["responses"][provider].encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *_):
        pass


with tempfile.TemporaryDirectory(prefix="mojentic-package-") as temporary:
    stage = pathlib.Path(temporary)
    archive = stage / "Mojentic.tar.gz"
    with tarfile.open(archive, "w:gz") as output:
        for name in ["Package.swift", "Package.resolved", "Sources", "Examples"]:
            output.add(root / name, arcname="Mojentic/" + name)
    print("tested source artifact sha256", hashlib.sha256(archive.read_bytes()).hexdigest(), flush=True)
    subprocess.run(["git", "rev-parse", "HEAD"], check=True, cwd=root)
    with tarfile.open(archive) as source:
        source.extractall(stage, filter="data")
    consumer = stage / "Consumer"
    (consumer / "Sources/Probe").mkdir(parents=True)
    (consumer / "Package.swift").write_text("""// swift-tools-version: 6.1
import PackageDescription
let package = Package(
    name: "Consumer", dependencies: [.package(path: "../Mojentic", traits: ["full"])],
    targets: [.executableTarget(name: "Probe", dependencies: [
        .product(name: "Mojentic", package: "Mojentic")])])
""")
    (consumer / "Sources/Probe/main.swift").write_text("""
import Foundation
import Mojentic

struct Row: Decodable {
    let model: String
    let explicit: Bool
    let reasoning: Bool
}
struct AnthropicRow: Decodable { let model: String; let id: String; let explicit_max_tokens: Int }
struct Contract: Decodable { let cases: [Row]; let anthropic_cases: [AnthropicRow] }
let contract = try JSONDecoder().decode(
    Contract.self, from: Data(contentsOf: URL(fileURLWithPath: CommandLine.arguments[2])))
let gateway = OpenAIGateway(
    apiKey: "contract-secret", baseURL: URL(string: CommandLine.arguments[1])!)
for row in contract.cases {
    let config = CompletionConfig(
        temperature: row.explicit ? 0 : nil, maxTokens: row.explicit ? 8192 : nil,
        topP: row.explicit ? 0.8 : nil, reasoning: row.reasoning ? .high : nil)
    let result = try await gateway.complete(
        model: row.model, messages: [.user("hello")], tools: nil, config: config)
    precondition(result.content == "answer")
    print("PASS consumer openai/" + row.model + (row.explicit ? "/explicit" : "/default"))
}
let anthropic = AnthropicGateway(
    apiKey: "contract-secret", baseURL: URL(string: CommandLine.arguments[1])!)
for row in contract.anthropic_cases {
    for explicit in [false, true] {
        let result = try await anthropic.complete(
            model: row.model, messages: [.user("hello")], tools: nil,
            config: CompletionConfig(temperature: explicit ? 0 : nil,
                                     maxTokens: explicit ? row.explicit_max_tokens : nil, reasoning: .high))
        precondition(result.content == "answer")
        print("PASS consumer " + row.id + (explicit ? "/explicit" : "/default"))
    }
}
""")
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Provider)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        result = subprocess.run(
            [str(root / "scripts/with-gate-environment"), "swift", "run",
             "--package-path", str(consumer), "Probe",
             f"http://127.0.0.1:{server.server_port}", str(contract_path)],
            capture_output=True, text=True, cwd=root)
        print(result.stdout, end="", flush=True)
        print(result.stderr, end="", flush=True)
        result.check_returncode()
        output_lines = (result.stdout + result.stderr).splitlines()
        for warning in {row["warning"] for row in contract["cases"] if "warning" in row}:
            expected_count = sum(row.get("warning") == warning for row in contract["cases"])
            actual = sum(line.endswith(warning) for line in output_lines)
            assert actual == expected_count, (warning, expected_count, actual)
            print("PASS consumer warning: " + warning, flush=True)
        assert len(verified) == len(rows)
        print(f'{contract["version"]}: detached archive, fresh SwiftPM consumer, all named provider/consumer cases passed')
    finally:
        server.shutdown()
        server.server_close()
