#!/usr/bin/env python3
"""Consume a fresh SwiftPM source artifact through public timing APIs over HTTP."""
import hashlib
import http.server
import json
import pathlib
import subprocess
import tarfile
import tempfile
import threading

root = pathlib.Path(__file__).resolve().parent.parent
contract = root / "Tests/MojenticTests/Fixtures/Contracts/stream_first_token_v1.json"
subprocess.run(["sha256sum", "--check", str(contract.with_name("stream_first_token_v1.manifest.sha256"))], check=True, cwd=root)
cases = {row["name"]: row["delta"] for row in json.loads(contract.read_text())["cases"]}
print("contract sha256", hashlib.sha256(contract.read_bytes()).hexdigest(), flush=True)
subprocess.run(["git", "rev-parse", "HEAD"], check=True, cwd=root)


class Provider(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        assert body["stream"] is True
        if body["model"] == "slow":
            import time
            time.sleep(0.2)
        if body["model"] == "failure":
            payload = b'data: {"error":{"message":"fixture failure"}}\n\n'
        else:
            delta = dict(cases["content-first"])
            if body["model"] != "fast":
                delta["reasoning_content"] = cases["thinking-first"]["thinking"]
            frame = {"model": "served", "choices": [{"delta": delta, "finish_reason": "stop"}],
                     "usage": {"prompt_tokens": 3, "completion_tokens": 2, "total_tokens": 5,
                               "time_to_first_token": 0.25}}
            payload = ("data: " + json.dumps(frame) + "\n\ndata: [DONE]\n\n").encode()
        if body["model"] == "rejected":
            payload = b"busy"
        self.send_response(503 if body["model"] == "rejected" else 200)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *_):
        pass


with tempfile.TemporaryDirectory(prefix="mojentic-timing-") as temporary:
    stage = pathlib.Path(temporary)
    archive = stage / "Mojentic.tar.gz"
    with tarfile.open(archive, "w:gz") as output:
        for name in ["Package.swift", "Package.resolved", "Sources", "Examples"]:
            output.add(root / name, arcname="Mojentic/" + name)
    print("tested source artifact sha256", hashlib.sha256(archive.read_bytes()).hexdigest(), flush=True)
    with tarfile.open(archive) as source:
        source.extractall(stage, filter="data")
    consumer = stage / "Consumer"
    (consumer / "Sources/Probe").mkdir(parents=True)
    (consumer / "Package.swift").write_text('''// swift-tools-version: 6.1
import PackageDescription
let package = Package(name: "Consumer", dependencies: [.package(path: "../Mojentic", traits: ["full"])],
    targets: [.executableTarget(name: "Probe", dependencies: [.product(name: "Mojentic", package: "Mojentic")])])
''')
    (consumer / "Sources/Probe/main.swift").write_text('''import Foundation
import Mojentic

func verify(_ evidence: CompletionEvidence) {
    precondition(evidence.metadata?["first_token_kind"] == .string("thinking"))
    guard case .number(let first) = evidence.metadata?["time_to_first_token_ms"],
        case .number(let duration) = evidence.metadata?["request_duration_ms"] else {
        fatalError("Missing client timing")
    }
    precondition(duration >= first && first >= 0)
    precondition(evidence.usage?.completionTokens == 2)
}
let gateway = OpenAIGateway(apiKey: "fixture", baseURL: URL(string: CommandLine.arguments[1])!)
var completed = false
for await event in try gateway.completeStreamEvents(model: "fixture", messages: [], config: .init()) {
    if case .completed(let evidence) = event { verify(evidence); completed = true }
}
precondition(completed)
print("PASS packaged single-turn timing and provider usage")
var legacyDone = false
for try await event in gateway.stream(model: "fixture", messages: [], tools: nil, config: .init()) {
    if case .done(_, _, let evidence) = event { verify(evidence!); legacyDone = true }
}
precondition(legacyDone)
print("PASS packaged throwing-stream terminal evidence")
var rejected = false
do {
    for try await _ in gateway.stream(model: "rejected", messages: [], tools: nil, config: .init()) {}
} catch let error as MojenticError {
    guard case .streamFailure(let failure) = error,
        case .http(let status, let body) = failure.cause as? MojenticError else {
        fatalError("Lost typed HTTP failure")
    }
    precondition(status == 503 && body == "busy")
    precondition(failure.evidence.metadata?["request_duration_ms"] != nil)
    precondition(failure.evidence.metadata?["first_token_kind"] == nil)
    rejected = true
}
precondition(rejected)
print("PASS packaged throwing failure retains MojenticError, original HTTP status and terminal timing")
var failed = false
for await event in try gateway.completeStreamEvents(model: "failure", messages: [], config: .init()) {
    if case .error(.streamFailure(let failure)) = event {
        precondition(failure.evidence.metadata?["request_duration_ms"] != nil)
        precondition(failure.evidence.metadata?["first_token_kind"] == nil)
        guard case .providerError = failure.cause as? MojenticError else { fatalError("Lost provider cause") }
        failed = true
    }
}
precondition(failed)
print("PASS packaged failure duration, absent tokens and original typed cause")
var final = false
for try await event in LLMBroker(gateway: gateway).stream(model: "fixture", messages: []) {
    if case .done(let response) = event {
        precondition(response.metadata?["first_token_kind"] == .string("thinking")); final = true
    }
}
precondition(final)
print("PASS packaged broker response metadata")
func completion(_ gateway: OpenAIGateway, model: String) async throws -> CompletionEvidence {
    for await event in try gateway.completeStreamEvents(model: model, messages: [], config: .init()) {
        if case .completed(let evidence) = event { return evidence }
    }
    fatalError("Expected completed evidence")
}
async let slow = completion(gateway, model: "slow")
async let fast = completion(gateway, model: "fast")
let (slowEvidence, fastEvidence) = try await (slow, fast)
precondition(slowEvidence.metadata?["first_token_kind"] == .string("thinking"))
precondition(fastEvidence.metadata?["first_token_kind"] == .string("content"))
guard case .number(let slowFirst) = slowEvidence.metadata?["time_to_first_token_ms"],
    case .number(let fastDuration) = fastEvidence.metadata?["request_duration_ms"] else {
    fatalError("Missing concurrent timing")
}
precondition(slowFirst >= 150 && slowFirst - fastDuration >= 100)
print("PASS packaged same-gateway concurrent thinking/content completions have independent clocks")

''')
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Provider)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        subprocess.run(["swift", "run", "--package-path", str(consumer), "Probe", f"http://127.0.0.1:{server.server_port}/v1"], check=True)
    finally:
        server.shutdown()
        server.server_close()
