{
  "gates": [
    {
      "name": "format",
      "command": "swift format lint --strict --recursive Sources Tests",
      "required": true
    },
    {
      "name": "lint",
      "command": "swiftlint --strict",
      "required": true
    },
    {
      "name": "build",
      "command": "swift build -c release",
      "required": true
    },
    {
      "name": "test",
      "command": "swift test --parallel",
      "required": true
    },
    {
      "name": "test-full-traits",
      "command": "swift test --traits full",
      "required": true
    },
    {
      "name": "docs",
      "command": "swift package --disable-sandbox generate-documentation --target Mojentic --output-path .build/docs --warnings-as-errors",
      "required": true
    }
  ]
}
