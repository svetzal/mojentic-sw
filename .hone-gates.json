{
  "gates": [
    {
      "name": "format",
      "command": "./scripts/with-gate-environment swift format lint --strict --recursive Sources Tests",
      "required": true
    },
    {
      "name": "lint",
      "command": "./scripts/with-gate-environment swiftlint --strict",
      "required": true
    },
    {
      "name": "build",
      "command": "./scripts/with-gate-environment swift build -c release",
      "required": true
    },
    {
      "name": "test",
      "command": "./scripts/with-gate-environment swift test --parallel",
      "required": true
    },
    {
      "name": "test-full-traits",
      "command": "./scripts/with-gate-environment swift test --traits full",
      "required": true
    },
    {
      "name": "docs",
      "command": "./scripts/with-gate-environment swift package --disable-sandbox generate-documentation --target Mojentic --output-path .build/docs --warnings-as-errors",
      "required": true
    }
  ]
}
